$TTL 86400
$ORIGIN 0.0.10.in-addr.arpa.

@ IN SOA ns1.unsigned.test. root.unsigned.test. (
    42   ; serial
    3H   ; refresh
    15M  ; retry
    1W   ; expire
    1D   ; minimum TTL
)

; NS info
@                     NS   ns1.unsigned.test.

; Reverse record for 10.0.0.111 (mail.unsigned.test), used to exercise DNS64
; reverse (PTR) synthesis: a PTR query for the address 64:ff9b::a00:6f is
; answered via a synthesized CNAME to 111.0.0.10.in-addr.arpa.
111                   PTR  mail.unsigned.test.
